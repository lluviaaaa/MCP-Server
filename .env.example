# Copy this file to .env  (or just run: npm run setup, which also generates the tokens)
# Never commit .env. Never paste tokens into chats, screenshots or the report.

# --- Server ---------------------------------------------------------------
PORT=3333
# Keep 127.0.0.1: only the tunnel (ngrok) on this machine should reach the server directly.
HOST=127.0.0.1
# The ONLY folder agents can touch. Relative paths are resolved from the project folder.
WORKSPACE_ROOT=workspace
LOG_DIR=logs

# --- Secrets (each 24-128 chars: letters, digits, . _ ~ -) ----------------
# admin    = every tool, including delete_file   (you)
# coder    = read + write + git commit, no delete (the agent that builds things)
# reviewer = read-only + append to the logs       (an agent that plans / reviews)
# Generate one with: npm run gen-token
ADMIN_TOKEN=
CODER_TOKEN=
REVIEWER_TOKEN=

# Also accept the token as a secret URL segment:  https://HOST/s/<token>/mcp
# Needed for clients that cannot send an Authorization header (many Claude plans).
ALLOW_PATH_TOKEN=true

# --- Optional -------------------------------------------------------------
# Your tunnel address, used only by "npm run urls" to print connector URLs.
PUBLIC_URL=
ALLOW_DELETE=true
MAX_FILE_BYTES=1000000
MAX_BODY_BYTES=2000000
GIT_AUTHOR_NAME=MCP File Server
GIT_AUTHOR_EMAIL=mcp@localhost
# Browsers send an Origin header; servers should reject unknown ones (DNS-rebinding defence).
# Claude's cloud and the MCP Inspector proxy send none, so leave this empty unless you
# deliberately use a browser-based client. Comma-separated list.
ALLOWED_ORIGINS=
